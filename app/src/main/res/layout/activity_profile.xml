<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F5FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- ============================= -->
        <!-- HEADER -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  PERSONAL SPACE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7D6AA8"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Profile"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#27213A"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personalize your health journey 💜"
                    android:textSize="13sp"
                    android:textColor="#8A8493"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="26sp"
                android:background="#EDE6F9"/>

        </LinearLayout>


        <!-- ============================= -->
        <!-- PERSONAL DETAILS -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E9E2F2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="17dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🧑"
                        android:textSize="24sp"
                        android:background="#EFE8FA"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PERSONAL DETAILS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#8A8493"
                            android:letterSpacing="0.06"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tell us about yourself"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#302A3D"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- NAME -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Your Name"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textColor="#27213A"
                    android:textColorHint="#AAA4B2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#F5F2F8"
                    android:layout_marginBottom="14dp"/>


                <!-- AGE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Age"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textColor="#27213A"
                    android:textColorHint="#AAA4B2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#F5F2F8"
                    android:layout_marginBottom="14dp"/>


                <!-- GENDER -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spGender"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="#F5F2F8"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="14dp"/>


                <!-- WEIGHT -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Weight (kg)"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textColor="#27213A"
                    android:textColorHint="#AAA4B2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#F5F2F8"
                    android:layout_marginBottom="14dp"/>


                <!-- HEIGHT -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Height"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Height (cm)"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textColor="#27213A"
                    android:textColorHint="#AAA4B2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#F5F2F8"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- ACTIVITY & GOALS -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E9E2F2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="17dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="🎯"
                        android:textSize="24sp"
                        android:background="#EAF7EA"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ACTIVITY &amp; GOALS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#8A8493"
                            android:letterSpacing="0.06"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Set your daily targets"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#302A3D"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- ACTIVITY LEVEL -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activity Level"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spActivity"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="#F5F2F8"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp"/>


                <!-- GOAL -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#514B5D"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spGoal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="#F5F2F8"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- SAVE PROFILE -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#6B4FA8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾"
                    android:textSize="20sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save Profile"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>