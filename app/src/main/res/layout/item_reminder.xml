<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E9E2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="⏰"
            android:textSize="27sp"
            android:background="#EFE8FA"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏰ 07:00 AM"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#27213A"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvReminderMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise ka time ho gaya 🏃"
                android:textSize="14sp"
                android:textColor="#6F6A78"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvReminderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily • Alarm ON"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3FA76A"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <Switch
            android:id="@+id/switchReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"/>

        <TextView
            android:id="@+id/tvReminderMore"
            android:layout_width="38dp"
            android:layout_height="48dp"
            android:text="⋮"
            android:textSize="28sp"
            android:textColor="#514B5D"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>