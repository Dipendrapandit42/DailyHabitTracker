<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarm -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Full-screen alarm -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Restart alarms after phone reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Alarm support -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyHabitTracker">

        <!-- Opening / Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Habit -->
        <activity
            android:name=".AddHabitActivity"
            android:exported="false" />

        <activity
            android:name=".AllHabitsActivity"
            android:exported="false" />

        <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Statistics -->
        <activity
            android:name=".StatisticsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Nutrition -->
        <activity
            android:name=".NutritionActivity"
            android:exported="false" />

        <activity
            android:name=".AddFoodActivity"
            android:exported="false" />

        <!-- Exercise -->
        <activity
            android:name=".ExerciseActivity"
            android:exported="false" />

        <activity
            android:name=".AddExerciseActivity"
            android:exported="false" />

        <!-- Reminder -->
        <activity
            android:name=".ReminderActivity"
            android:exported="false" />

        <!-- Alarm Screen -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- Reminder Receiver -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Custom Alarm Receiver -->
        <receiver
            android:name=".CustomReminderReceiver"
            android:exported="false" />

        <!-- Re-schedule alarms after reboot -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>